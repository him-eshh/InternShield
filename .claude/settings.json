{
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true
  },
  "worktree": { "baseRef": "head" },
  "env": { "CLAUDE_CODE_RETRY_WATCHDOG": "1" },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read", "Glob", "Grep", "Write", "Edit", "Task", "TodoWrite",
      "Bash(npm:*)", "Bash(npx:*)", "Bash(node:*)", "Bash(ls:*)", "Bash(mkdir:*)", "Bash(cat:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(rm:*)", "Bash(curl:*)", "Bash(sleep:*)", "Bash(cd:*)", "Bash(pwd)", "Bash(echo:*)", "Bash(find:*)", "Bash(grep:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)", "Bash(sort:*)", "Bash(test:*)", "Bash(kill:*)",
      "Bash(git status:*)", "Bash(git add:*)", "Bash(git commit:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)", "Bash(git branch:*)", "Bash(git checkout:*)", "Bash(git switch:*)", "Bash(git merge:*)", "Bash(git worktree:*)", "Bash(git rev-parse:*)", "Bash(git check-ignore:*)", "Bash(git restore:*)", "Bash(git stash:*)", "Bash(git ls-files:*)",
      "PowerShell(npm:*)", "PowerShell(npx:*)", "PowerShell(node:*)", "PowerShell(Get-ChildItem:*)", "PowerShell(Get-Content:*)", "PowerShell(Test-Path:*)", "PowerShell(New-Item:*)", "PowerShell(Copy-Item:*)", "PowerShell(Move-Item:*)", "PowerShell(Remove-Item:*)", "PowerShell(Invoke-WebRequest:*)", "PowerShell(Start-Process:*)", "PowerShell(Stop-Process:*)", "PowerShell(Get-Process:*)", "PowerShell(Start-Sleep:*)", "PowerShell(Select-String:*)", "PowerShell(git:*)"
    ],
    "deny": [
      "Bash(git push:*)", "PowerShell(git push:*)", "Bash(git remote:*)", "PowerShell(git remote:*)", "Bash(git reset --hard:*)", "Bash(git clean:*)", "Bash(vercel:*)", "Bash(npx vercel:*)", "Bash(gh:*)",
      "Read(./.env.local)", "Read(./.env)", "Bash(cat .env*)", "PowerShell(Get-Content .env*)"
    ]
  }
}
