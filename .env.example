# Copy to .env.local and fill in. Server-only: never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=
TAVILY_API_KEY=
# Optional: without it the Hunter check simply doesn't exist.
HUNTER_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000
DAILY_CHECK_CAP=120
TAVILY_DAILY_CAP=30
WIKIDATA_DAILY_CAP=300
# Company intel (/api/intel) lookups per day; each uses up to 2 of the Tavily searches above
INTEL_DAILY_CAP=15
# Tier 2 + 3 AI routes (site-wide per day; all share qwen's free budget, see devpost/tier3-spec.md)
REWRITE_DAILY_CAP=30
TRANSCRIBE_DAILY_CAP=12
INTERVIEW_DAILY_CAP=50
# Optional Groq model ids (defaults in lib/server/groq.ts)
VISION_MODEL=qwen/qwen3.8-27b
INTERVIEW_MODEL=qwen/qwen3.8-27b
REWRITE_MODEL=qwen/qwen3.8-27b
